AC_PREREQ([2.69])
AC_INIT([lab08-autotools],[1.0],[https://github.com/Dimasos88/lab08-autotools/issues])
AC_CONFIG_SRCDIR([keys.c])
AC_CONFIG_HEADERS([config.h])
AM_INIT_AUTOMAKE([foreign])
AC_PROG_CC
AC_CHECK_LIB([ncursesw],[initscr],[CURSES_LIBS="-lncursesw"],[AC_MSG_ERROR([ncursesw development library is required])])
AC_CHECK_HEADERS([ncurses.h ncursesw/ncurses.h])
AS_IF([test "x$ac_cv_header_ncurses_h" != xyes && test "x$ac_cv_header_ncursesw_ncurses_h" != xyes],[AC_MSG_ERROR([ncurses.h is required])])
AC_CHECK_HEADERS([unistd.h stdint.h])
AC_CHECK_LIB([lab08_nonexistent],[missing_symbol],[],[])
AC_ARG_ENABLE([keypad],[AS_HELP_STRING([--disable-keypad],[read raw terminal escape sequences])],[],[enable_keypad=yes])
AS_CASE([$enable_keypad],[yes],[AC_DEFINE([USE_KEYPAD],[1],[Enable keypad decoding])],[no],[],[AC_MSG_ERROR([keypad expects yes or no])])
AC_ARG_WITH([margin],[AS_HELP_STRING([--with-margin=N],[window margin, 0 through 9])],[],[with_margin=2])
AS_CASE([$with_margin],[[[0-9]]],[],[AC_MSG_ERROR([margin must be a digit])])
AC_DEFINE_UNQUOTED([WINDOW_MARGIN],[$with_margin],[Window margin])
AC_SUBST([CURSES_LIBS])
AC_CONFIG_FILES([Makefile])
AC_OUTPUT
